{
  "name": "febro-one",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "VITE_TRIAL=true vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build && esbuild apps/api/src/server.ts --bundle --platform=node --packages=external --format=esm --outfile=build/server.js",
    "build:trial": "VITE_TRIAL=true vite build",
    "start": "node --env-file=.env build/server.js",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "admin": "node --env-file=.env --import tsx scripts/admin.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.0",
    "@tiptap/react": "^3.6.0",
    "@tiptap/starter-kit": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.2.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fastify": "^5.6.0",
    "file-type": "^21.0.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.6.0",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.10",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
