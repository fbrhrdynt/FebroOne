NODE_ENV=production
APP_ORIGIN=https://one.febro.id
PORT=3471
TZ=Asia/Jakarta
DATABASE_URL=postgresql://febro_one:CHANGE_ME@127.0.0.1:5432/febro_one
UPLOAD_DIR=/var/lib/febro-one/uploads
# Optional OpenAI-compatible provider. Leave blank to disable AI.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Only used by backup script: public age recipient, never the private identity.
BACKUP_AGE_RECIPIENT=

# Private server-to-server integration (no secrets in Git).
FEBRO_ONE_CMS_SECRET=
CMS_INTERNAL_URL=http://127.0.0.1:3090
CMS_ADMIN_USER_IDS=
FEBRO_ONE_FILES_SERVICE_TOKEN=
FEBRO_FILES_API_URL=http://127.0.0.1:3480
